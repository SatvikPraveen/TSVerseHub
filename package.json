{
  "name": "tsversehub",
  "private": true,
  "version": "1.1.0",
  "description": "An interactive, research-grade TypeScript learning platform: typed curriculum modules, an in-browser compiler playground built on the TypeScript Compiler API, and a verified type-level test harness.",
  "type": "module",
  "keywords": [
    "typescript",
    "type-system",
    "compiler-api",
    "education",
    "interactive-learning",
    "playground",
    "react",
    "vite",
    "monaco-editor",
    "type-level-programming"
  ],
  "author": {
    "name": "Satvik Praveen",
    "email": "satvikpraveen707@gmail.com",
    "url": "https://github.com/SatvikPraveen"
  },
  "license": "MIT",
  "homepage": "https://github.com/SatvikPraveen/TSVerseHub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SatvikPraveen/TSVerseHub.git"
  },
  "bugs": {
    "url": "https://github.com/SatvikPraveen/TSVerseHub/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "typecheck:types": "tsc -p tsconfig.typetests.json --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"{src,tests,scripts,research,docs}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"{src,tests,scripts,research,docs}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "research:benchmark": "tsx research/benchmarks/run-benchmarks.ts",
    "research:verify": "tsx research/verification/verify-curriculum.ts",
    "generate:cheatsheets": "tsx scripts/generate-cheatsheets.ts",
    "build:playground": "tsx scripts/build-playground.ts",
    "export:pdf": "tsx scripts/export-pdf.ts",
    "sync:badges": "tsx scripts/sync-readme-badges.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "clean": "rimraf dist coverage .vite research/results/*.json",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.453.0",
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "expect-type": "^1.1.0",
    "fast-check": "^4.10.2",
    "glob": "^13.0.6",
    "husky": "^9.1.6",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "marked": "^18.0.14",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.1",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
